http://{$DOMAIN} {
    handle /generate_204 {
        respond 204
    }
    handle {
        redir https://{host}{uri}
    }
}

https://{$DOMAIN} {
    handle /admin* {
        basic_auth {
            {$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
        }
        reverse_proxy headplane:3000
    }

    handle {
        reverse_proxy headscale:8080 {
            header_up True-Client-IP {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
}